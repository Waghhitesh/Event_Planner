# EventPulse AI — Environment Variables
# Copy this file to .env.local and fill in your values.

# Required: Your Google AI Studio API key
# Get one at: https://aistudio.google.com/app/apikey (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the default Gemini model
# Defaults to: gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash
